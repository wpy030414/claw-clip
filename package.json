{
  "name": "claw-clip",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run copy:vditor && vite",
    "build": "npm run copy:vditor && tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "copy:vditor": "node scripts/copy-vditor.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-vditor.mjs || true"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@m3e/react": "^2.8.3",
    "@m3e/web": "^2.8.3",
    "lit": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tslib": "^2.8.1",
    "vditor": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^6.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
